{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(python tools/strateg.py *)",
      "Bash(python3 tools/strateg.py *)",
      "Bash(python projects/*)",
      "Bash(python3 projects/*)",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/tools/hooks/session_start.py\" 2>/dev/null || python3 \"${CLAUDE_PROJECT_DIR}/tools/hooks/session_start.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/tools/hooks/guard.py\" 2>/dev/null || python3 \"${CLAUDE_PROJECT_DIR}/tools/hooks/guard.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/tools/hooks/journal.py\" 2>/dev/null || python3 \"${CLAUDE_PROJECT_DIR}/tools/hooks/journal.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/tools/hooks/stop_cost.py\" 2>/dev/null || python3 \"${CLAUDE_PROJECT_DIR}/tools/hooks/stop_cost.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
