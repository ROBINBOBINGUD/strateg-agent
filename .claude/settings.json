{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(python tools/strateg.py *)",
      "Bash(python3 tools/strateg.py *)",
      "Bash(python projects/*/analysis/*.py)",
      "Bash(python3 projects/*/analysis/*.py)",
      "PowerShell(python tools/strateg.py *)",
      "PowerShell(python projects/*/analysis/*.py)",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/tools/hooks/run.sh\" session_start.py",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/tools/hooks/run.sh\" guard.py",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/tools/hooks/run.sh\" stop_cost.py",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/tools/hooks/run.sh\" journal.py",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/tools/hooks/run.sh\" stop_cost.py",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
